---
import Search from 'virtual:starlight/components/Search';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import { loadCourses, coursePath } from '../lib/courses.mjs';
import { parseRoute } from '../lib/route.mjs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { current, groups, courses } = loadCourses();
const { semester, course } = parseRoute(Astro.url.pathname);
const cur = courses.find((c) => c.id === course && c.semester === semester);
const sections = groups
	.map((group) => ({
		group,
		items: courses.filter((c) => c.semester === current && !c.archived && c.group === group),
	}))
	.filter((s) => s.items.length > 0);
---

<div class="header">
	<a class="logo" href={`${base}/`}>강의 기록</a>
	{
		cur && (
			<>
				<span class="sep" aria-hidden="true">/</span>
				<details class="switch">
					<summary>
						<span class="cur">{cur.name}</span>
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
					</summary>
					<div class="panel">
						{sections.map(({ group, items }) => (
							<div class="grp">
								<div class="gname">{group}</div>
								{items.map((c) => (
									<a href={base + coursePath(c)} aria-current={c === cur ? 'page' : undefined}>{c.name}</a>
								))}
							</div>
						))}
						<a class="more" href={`${base}/archive/`}>지난 학기 · 보관함</a>
					</div>
				</details>
			</>
		)
	}
	<span class="grow"></span>
	<div class="print:hidden"><Search /></div>
	<div class="sl-hidden md:sl-flex print:hidden"><ThemeSelect /></div>
</div>

<script>
	document.addEventListener('click', (e) => {
		const d = document.querySelector<HTMLDetailsElement>('details.switch');
		if (d?.open && !d.contains(e.target as Node)) d.open = false;
	});
</script>

<style>
	.header {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		height: 100%;
	}
	.grow {
		flex-grow: 1;
	}
	.logo {
		font-weight: 700;
		font-size: 1.125rem;
		color: var(--sl-color-white);
		text-decoration: none;
		white-space: nowrap;
	}
	.sep {
		color: var(--sl-color-gray-3);
	}
	.switch {
		position: relative;
		min-width: 0;
	}
	.switch summary {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		height: 2.25rem;
		max-width: 16rem;
		padding: 0 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.6rem;
		font-size: var(--sl-text-sm);
		font-weight: 500;
		color: var(--sl-color-white);
		cursor: pointer;
		list-style: none;
	}
	.switch summary::-webkit-details-marker {
		display: none;
	}
	.cur {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.panel {
		position: absolute;
		top: calc(100% + 0.4rem);
		inset-inline-start: 0;
		z-index: 10;
		width: 18rem;
		max-height: 70vh;
		overflow-y: auto;
		padding: 0.5rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.75rem;
		background: var(--sl-color-bg-nav);
	}
	.gname {
		padding: 0.5rem 0.6rem 0.2rem;
		font-size: var(--sl-text-xs);
		font-weight: 700;
		color: var(--sl-color-gray-3);
	}
	.panel a {
		display: block;
		padding: 0.45rem 0.6rem;
		border-radius: 0.5rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
		text-decoration: none;
	}
	.panel a:hover {
		background: var(--sl-color-gray-6);
	}
	.panel a[aria-current='page'] {
		background: var(--sl-color-accent-low);
		color: var(--sl-color-accent-high);
		font-weight: 700;
	}
	.panel .more {
		margin-top: 0.4rem;
		border-top: 1px solid var(--sl-color-gray-5);
		border-radius: 0;
		color: var(--sl-color-gray-3);
	}
</style>

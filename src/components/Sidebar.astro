---
import { coursePath, loadCourses } from '../lib/courses.mjs';
import { fmtDate, lecturePath, lecturesOf } from '../lib/lectures.mjs';
import { parseRoute } from '../lib/route.mjs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { semester, course, lecture } = parseRoute(Astro.url.pathname);
const cur = loadCourses().courses.find((c) => c.id === course && c.semester === semester);
const lectures = cur ? (await lecturesOf(semester, course)).reverse() : [];
---

{
	cur && (
		<nav aria-label="이 과목의 강의">
			<a class="all" href={base + coursePath(cur)}>전체 강의 목록</a>
			<ul>
				{lectures.map((l) => (
					<li>
						<a href={base + lecturePath(l.id)} aria-current={l.date === lecture ? 'page' : undefined} title={`${fmtDate(l.date)} · ${l.title}`}>
							<span class="n">{l.n}회</span>
							<span class="t">{l.title}</span>
						</a>
					</li>
				))}
			</ul>
		</nav>
	)
}

<style>
	nav {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 2px;
	}
	a {
		display: flex;
		gap: 0.5rem;
		align-items: baseline;
		padding: 0.45rem 0.65rem;
		border-radius: 0.5rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
		text-decoration: none;
	}
	a:hover {
		background: var(--sl-color-gray-6);
	}
	.all {
		font-size: var(--sl-text-xs);
		font-weight: 700;
		color: var(--sl-color-gray-3);
	}
	a[aria-current='page'] {
		background: var(--sl-color-accent-low);
		color: var(--sl-color-accent-high);
		font-weight: 700;
	}
	.n {
		flex: none;
		color: var(--sl-color-gray-3);
	}
	.t {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
</style>

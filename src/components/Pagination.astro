---
import { fmtDate, lecturePath, lecturesOf } from '../lib/lectures.mjs';
import { parseRoute } from '../lib/route.mjs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { semester, course, lecture } = parseRoute(Astro.url.pathname);
const list = lecture ? await lecturesOf(semester, course) : [];
const i = list.findIndex((l) => l.date === lecture);
const prev = i > 0 ? list[i - 1] : undefined;
const next = i >= 0 && i < list.length - 1 ? list[i + 1] : undefined;
---

{
	i >= 0 && (
		<nav class="pager print:hidden" aria-label="이전 다음 강의">
			{prev ? (
				<a href={base + lecturePath(prev.id)} rel="prev">
					<span class="lbl">이전</span>
					<span class="ttl">{prev.n}회 · {prev.title}</span>
				</a>
			) : (
				<span />
			)}
			{next ? (
				<a class="r" href={base + lecturePath(next.id)} rel="next">
					<span class="lbl">다음</span>
					<span class="ttl">{next.n}회 · {next.title}</span>
				</a>
			) : (
				<span />
			)}
		</nav>
	)
}

<style>
	.pager {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
		margin-top: 3rem;
	}
	a {
		display: block;
		padding: 0.85rem 1.1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.75rem;
		text-decoration: none;
	}
	a:hover {
		border-color: var(--sl-color-accent);
	}
	.r {
		text-align: end;
	}
	.lbl {
		display: block;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.ttl {
		display: block;
		margin-top: 0.15rem;
		font-weight: 500;
		color: var(--sl-color-white);
	}
</style>
